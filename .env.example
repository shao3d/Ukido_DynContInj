# OpenRouter API Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration (optional)
# Default model for routing/classification through OpenRouter
# ROUTER_MODEL=google/gemini-3.5-flash-lite
# MODEL=google/gemini-3.5-flash-lite  # Backward-compatible alias

# Model for generating final answers (optional)
# Default: openai/gpt-6-luna
# MODEL_ANSWER=openai/gpt-6-luna
# ANSWER_MODEL=openai/gpt-6-luna  # Backward-compatible alias

# Temperature for final answer generation (optional), default 0.6
# Higher = more lively/personable replies; facts stay grounded by the KB.
# ANSWER_TEMPERATURE=0.6

# Model for translation and humor generation (optional)
# TRANSLATION_MODEL=google/gemini-3.5-flash-lite
# ZHVANETSKY_MODEL=google/gemini-3.5-flash-lite
# HUMOR_MODEL=google/gemini-3.5-flash-lite  # Backward-compatible alias

# HubSpot CRM Configuration
# Get your Private App Token at: https://app.hubspot.com/settings/private-apps
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here

# Your HubSpot Portal ID (find it in HubSpot settings)
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here

# Public API surface (optional)
# Set ADMIN_API_TOKEN to enable protected admin endpoints like /metrics and /clear_history
# ADMIN_API_TOKEN=change_me
# CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://shao3d.github.io
# CORS_ALLOW_CREDENTIALS=true

# Persistence and test/prod behavior (optional)
# PERSISTENCE_BASE_PATH=data/persistent_states
# DETERMINISTIC_MODE=false

# Trial signup contacts shown in answers (optional)
# Default: trial page URL only. Set CONTACT_PHONE to also offer a phone call;
# leave empty so the assistant never invents/advertises an unverified number.
# TRIAL_SIGNUP_URL=https://shao3d.github.io/trial/
# CONTACT_PHONE=+380 XX XXX XX XX

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8000
